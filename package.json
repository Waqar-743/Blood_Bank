{
  "name": "nutech-bloodbank",
  "version": "1.0.0",
  "private": true,
  "description": "Nutech Blood Bank — frontend build (Tailwind) + scripts wrapping the backend.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./assets/tailwind.css --watch",
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
