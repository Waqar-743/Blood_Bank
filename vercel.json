{
  "version": 2,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { "src": "image/**",          "use": "@vercel/static" },
    { "src": "frontend/**",       "use": "@vercel/static" },
    { "src": "assets/**",         "use": "@vercel/static" },
    { "src": "Landing Page.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)",       "dest": "backend/server.js" },
    { "src": "/admin(.*)",      "dest": "backend/server.js" },
    { "src": "/image/(.*)",     "dest": "/image/$1" },
    { "src": "/frontend/(.*)",  "dest": "/frontend/$1" },
    { "src": "/assets/(.*)",    "dest": "/assets/$1" },
    { "src": "/",               "dest": "/Landing Page.html" },
    { "src": "/(.*)",           "dest": "backend/server.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
